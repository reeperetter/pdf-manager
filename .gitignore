Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

